{
  "name": "substrakt",
  "version": "0.1.0",
  "description": "Local document extractor",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bash scripts/start.sh",
    "setup": "bash scripts/setup-dev.sh && bash scripts/fetch-models.sh",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:wsl": "bash scripts/dev-wsl.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "licenses": "python3 scripts/check-licenses.py",
    "egress": "bash scripts/check-egress.sh",
    "corpus": "cd sidecar && uv run python ../corpus/generate.py",
    "bench": "cd sidecar && uv run python ../bench/run.py",
    "test:sidecar": "cd sidecar && uv run pytest ../tests/sidecar/",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:sidecar && npm run licenses && npm run egress"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "lucide-react": "^1.27.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
